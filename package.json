{
  "name": "mdquiz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist/mdquiz.js",
  "files": [
    "demo",
    "dist",
    "src/*",
    "tsconfig.json",
    "vite.config-lib.ts",
    ".npmignore"
  ],
  "exports": {
    ".": {
      "buildQuiz": "./dist/mdquiz"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build -c vite.config-lib.ts",
    "build-demo": "vite build -c vite.config-demo.ts && vite preview --open",
    "dev": "npm run build && vite build -c vite.config-demo.ts && vite preview --open -c vite.config-demo.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "@prantlf/jsonlint": "^17.0.1",
    "classnames": "^2.5.1",
    "fast-deep-equal": "^3.1.3",
    "globals": "^16.5.0",
    "highlight.js": "^11.12.0",
    "mobx": "^6.16.1",
    "mobx-react": "npm:mobx-react-lite@^4.1.1",
    "object-hash": "^3.0.0",
    "preact": "^10.29.8",
    "pyret-embed": "^0.0.1",
    "react": "npm:@preact/compat@^18.3.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "npm:@preact/compat@^18.3.2",
    "react-hook-form": "^7.90.0",
    "react-showdown": "^2.3.1",
    "typescript": "5.8.2",
    "vite": "^8.3.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.8",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^29.1.1",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@prantlf/jsonlint": {
      "ajv": "^8.18.0"
    }
  }
}
